# Copy this file to `server/.env` and fill in REAL values.
# `server/.env` is git-ignored and must NEVER be committed.
# This example file contains placeholders only — no secrets.

# PostgreSQL / Neon connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:5432/database

# Google AI Studio API key (AI assistant + study planner)
GEMINI_API_KEY=your-gemini-api-key

# Secret used to sign session cookies. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret